# Copy to deploy/.env and fill in. deploy/.env is gitignored — never commit it.

# PostgreSQL (Demo 1 platform database, synthetic + app data)
POSTGRES_DB=zharfa
POSTGRES_USER=zharfa
POSTGRES_PASSWORD=

# Single cloud AI provider for Demo 1 (Business Analyst agent).
# Demo 1 ships exactly one provider; the local Ollama seam is an interface
# only, not implemented here.
AI_PROVIDER_NAME=
AI_PROVIDER_ENDPOINT=
AI_PROVIDER_MODEL=
AI_PROVIDER_API_KEY=

# Inventory alert threshold (Inventory__LowStockThreshold, default 10)
# INVENTORY_LOW_STOCK_THRESHOLD=

# Published port of the web / reverse-proxy service.
ZHARFA_PORT=8080
