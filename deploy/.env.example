# Copy to deploy/.env and fill in. deploy/.env is gitignored — never commit it.

# PostgreSQL (Demo 1 platform database, synthetic + app data)
POSTGRES_DB=zharfa
POSTGRES_USER=zharfa
POSTGRES_PASSWORD=

# Single cloud AI provider for Demo 1 (Business Analyst agent).
# Demo 1 ships exactly one provider; the local Ollama seam is an interface
# only, not implemented here.
AI_PROVIDER_NAME=
AI_PROVIDER_ENDPOINT=
AI_PROVIDER_MODEL=
AI_PROVIDER_API_KEY=

# Inventory alert threshold (Inventory__LowStockThreshold, default 10)
# INVENTORY_LOW_STOCK_THRESHOLD=

# Published port of the web / reverse-proxy service.
ZHARFA_PORT=8080

# Mabna SIMULATOR (deploy/docker-compose.mabna-sim.yml) - local offline dev only.
# SA password must satisfy SQL Server complexity (8+ chars, 3 of 4 classes).
MABNA_SIM_SA_PASSWORD=
# Password for the read-only login zharfa_ro created in the simulator.
MABNA_SIM_RO_PASSWORD=
# MABNA_SIM_PORT=14330

# Mabna read-only source (API, backend/Zharfa.Api/Mabna, spec 002).
# Unset = connector disabled; the API still starts. Simulator vs live Mabna is
# only a different connection string. Use the read-only login (zharfa_ro);
# ApplicationIntent=ReadOnly does NOT enforce read-only. These are ASP.NET
# Core names: the api service in docker-compose must pass them through.
# ConnectionStrings__Mabna=Server=host,1433;Database=TotalSystem;User Id=zharfa_ro;Password=...;TrustServerCertificate=True
# Allowlist of tables/views (real names stay out of git): list entries, or a
# gitignored file with one schema.object per line. scu*/msg*/users/UserRights
# are always refused regardless of this list.
# MabnaSource__AllowedObjects__0=
# MabnaSource__AllowlistFile=
# MabnaSource__CommandTimeoutSeconds=60
# MabnaSource__MaxRows=10000
# Permission-metadata check at startup/first read (default true). If the login
# can write, the connector refuses to run unless this override is true:
# MabnaSource__AllowWritableLogin=false

# --- Phase 1: Real Purchase Data ---

# Install data mode (required: "production" or "demo"). The API refuses to start if missing or invalid.
ZHARFA_DATA_MODE=

# Bootstrap credentials (production only, used once when app_user is empty; password >= 12 chars).
Bootstrap__AdminUsername=
Bootstrap__AdminPassword=
Bootstrap__ManagerUsername=
Bootstrap__ManagerPassword=

# Container paths of the purchasing source map and the allowlist (unset disables sync with 'source-not-configured').
# Both files live in a gitignored host folder that compose mounts read-only at /etc/zharfa/mabna:
#   ZHARFA_MABNA_CONFIG_DIR (default ./mabna-config, i.e. deploy/mabna-config/)
# Example: MabnaSync__SourceMapFile=/etc/zharfa/mabna/source-map.json
#          MabnaSource__AllowlistFile=/etc/zharfa/mabna/allowlist.txt
# ZHARFA_MABNA_CONFIG_DIR=./mabna-config
MabnaSync__SourceMapFile=

# Per-source-query timeout in seconds (FR-011 default 60).
MabnaSource__CommandTimeoutSeconds=60

# Nightly incremental sync schedule (default 02:00 in Asia/Tehran). Blank = default.
Sync__NightlyTime=
Sync__TimeZone=
# Day of week for weekly full load (default Friday; "None" disables).
Sync__WeeklyFullLoadDay=
# Sync page size (default 5000, <= MabnaSource__MaxRows). Blank = default.
Sync__PageSize=
# Maximum rejected rows allowed before run fails (default 0). Blank = default.
Sync__MaxRejectedRows=
# Fault injection for dev testing (only in Development + demo mode). Blank = no fault.
Sync__FaultInjection__FailAfterTables=

# Purchasing discount basis ("line" or "lineAndDocument", default "line").
# In production this must equal the source map's discountBasis.value or the API refuses to start.
Purchasing__DiscountBasis=

